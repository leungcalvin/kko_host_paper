@inproceedings{chen1996western,
	title        = {The Western Canada Deformation Array: An Update on GPS Solutions and Error Analysis},
	author       = {Chen, Xin and Langley, Richard B. and Dragert, Herb},
	year         = 1996,
	booktitle    = {GPS Trends in Precise Terrestrial, Airborne, and Spaceborne Applications},
	publisher    = {Springer Berlin Heidelberg},
	address      = {Berlin, Heidelberg},
	pages        = {70--74},
	isbn         = {978-3-642-80133-4},
	editor       = {Beutler, Gerhard and Melbourne, William G. and Hein, G{\"u}nter W. and Seeber, G{\"u}nter},
	abstract     = {The Western Canada Deformation Array (WCDA) is a network of continuous GPS trackers established in the fall of 1992 to monitor crustal deformation across the northern Cascadia subduction zone located in southwestern British Columbia. As of April 1995, the WCDA comprises five tracking sites. The names, site ID's, and the starting dates of operation for the five sites are: Dominion Radio Astrophysical Observatory (Penticton) --- DRAO (02/91), Albert Head (Victoria) --- ALBH (05/92), Holberg --- HOLB (07/92), Williams Lake --- WILL (10/93), Ucluelet --- UCLU (05/94). The geometric configuration of the WCDA and the basic tectonic setting of the region are illustrated in Fig. 1. Although they both form part of the oceanic side of the Cascadia subduction zone, the Explorer Plate and the Juan de Fuca Plate interact differently with the overlying North American Plate margin. Conventional terrestrial geodetic surveys have been carried out in the past on the southern part of Vancouver Island and have revealed an uplift rate at the outer coast of Vancouver Island of a few mm/yr and a shortening rate of 0.1 ustrain/yr (Dragert et al., 1994).}
}
